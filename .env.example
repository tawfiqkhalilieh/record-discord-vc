# Generate each secret separately: openssl rand -hex 32
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Optional role permitted to record, in addition to members with Manage Guild.
RECORD_ROLE_ID=
# Optional human recorder account to omit from roster tiles.
RECORDER_USER_ID=

MINIO_ROOT_USER=vc-stash
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
S3_BUCKET=recordings
S3_REGION=us-east-1
# Internal Docker endpoint. Dashboard proxies playback; no public S3 URL needed.
S3_ENDPOINT=http://minio:9000
ADMIN_PASSWORD=replace-with-a-different-long-random-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
RECORDER_API_KEY=replace-with-another-long-random-secret
VNC_PASSWORD=change-me

# Dashboard only. Bind to localhost and expose through Tailscale Serve.
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Set true when serving HTTPS through Tailscale.
COOKIE_SECURE=false

# Only localhost publishes noVNC and MinIO admin console.
NOVNC_PORT=6080
MINIO_CONSOLE_PORT=9001
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=30
CAPTURE_VIDEO_SELECTOR=video
# Optional CSS selector relative to each video's parent for its label.
CAPTURE_NAME_SELECTOR=
MAX_RECORDING_SECONDS=14400
